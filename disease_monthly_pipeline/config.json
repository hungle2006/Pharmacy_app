{
  "dataset_repo": "leminhhung0101/disease_data",
  "model_repo": "leminhhung0101/disease_model",
  "base_model": "FacebookAI/xlm-roberta-base",
  "benchmark_version": "v1",
  "parquet_patterns": [
    "*.parquet",
    "**/*.parquet"
  ],
  "skip_unchanged": false,
  "epochs": 6,
  "batch_size": 8,
  "max_length": 256,
  "learning_rate": 0.00002,
  "minimum_validation_macro_f1": 0.2,
  "promotion_tolerance": 0,
  "class_weight": "balanced",
  "prevent_accuracy_regression": true
}
